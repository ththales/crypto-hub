<%- include("./partials/header.ejs"); %>

<main>
    <div class="hero px-4 py-5 text-center">
        <img class="d-block mx-auto mb-4" src="/img/logo.png" alt="" width="100">
        <h1 class="display-5 fw-bold text-body-emphasis">Crypto-Hub</h1>
        <div class="col-lg-6 mx-auto">
            <p class="lead mb-4">Explore the world of cryptography in one place. Crypto-Hub is a web-based toolkit for encoding, decoding, and experimenting with classical ciphers and modern cryptographic algorithms. Inspired by the simplicity of old-school cryptography websites, it turns complex techniques into an accessible and interactive experience.</p>
        </div>
    </div>
    
    <br>

    <div class="main-content">
        <h2>Ciphers</h1>
        <% if(locals.ciphers) { %>
            <div class="cards">
                <% for(let i=0; i<ciphers.length; i++) { %>
                    <a href="<%= ciphers[i].path %>" class="card-link">
                        <div class="card" style="width: 18rem;">
                            <div class="card-body">
                                <h5 class="card-title"><%= ciphers[i].name %></h5>
                                <p class="card-text"><%= ciphers[i].description %></p>
                            </div>
                        </div>
                    </a>
                <% } %>
            </div>
        <% } %>
    
        <br>
    
        <h2>Encryption</h2>
        <% if(locals.cryptography) { %>
            <div class="cards">
                <% for(let i=0; i<cryptography.length; i++) { %>
                    <a href="<%= cryptography[i].path %>" class="card-link">
                        <div class="card" style="width: 18rem;">
                            <div class="card-body">
                                <h5 class="card-title"><%= cryptography[i].name %></h5>
                                <p class="card-text"><%= cryptography[i].description %></p>
                                <p class="card-text"><b><%= cryptography[i].type %></b></p>
                            </div>
                        </div>
                    </a>
                <% } %>
            </div>
        <% } %>
    </div>
</main>

<%- include("./partials/footer.ejs") %>