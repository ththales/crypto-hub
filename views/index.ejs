<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crypto-Hub</title>
    <link rel="stylesheet" href="./styles/index.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
    <body>
        <%- include("./partials/header.ejs"); %>

        <main>
            <h2>Ciphers</h1>
            <% if(locals.ciphers) { %>
                <div class="cards">
                    <% for(let i=0; i<ciphers.length; i++) { %>
                        <div class="card" style="width: 18rem;">
                            <div class="card-body">
                                <h5 class="card-title"><%= ciphers[i].name %></h5>
                                <p class="card-text"><%= ciphers[i].description %></p>
                                <a href="<%= ciphers[i].path %>" class="card-link">Access</a>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } %>

            <br>

            <h2>Encryption</h2>
            <% if(locals.cryptography) { %>
                <div class="cards">
                    <% for(let i=0; i<cryptography.length; i++) { %>
                        <div class="card" style="width: 18rem;">
                            <div class="card-body">
                                <h5 class="card-title"><%= cryptography[i].name %></h5>
                                <p class="card-text"><%= cryptography[i].description %></p>
                                <p class="card-text"><b><%= cryptography[i].type %></b></p>
                                <a href="<%= cryptography[i].path %>" class="card-link">Access</a>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } %>
        </main>

        <%- include("./partials/footer.ejs") %>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    </body>
</html>