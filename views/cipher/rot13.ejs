<%- include("../partials/header.ejs"); %>

<main>
    <h2>Rot13 Cipher</h1>
    <br>
    <form action="/rot13" method="POST">
        <label for="text-input">Type or paste in the text you want to encrypt or decrypt</label>
        <br>

        <textarea name="text" style="resize: none"><%= text %></textarea>
        <br><br>
        
        <input name="action" type="submit" value="encrypt/decrypt">
    </form>
</main>

<%- include("../partials/footer.ejs") %>