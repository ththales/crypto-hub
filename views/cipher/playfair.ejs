<%- include("../partials/header.ejs"); %>

<main>
    <h2>Playfair Cipher</h2>
    <br>
    <form action="/playfair" method="POST">
        <label for="text-input">Type or paste in the text you want to encrypt or decrypt</label>
        <br>

        <textarea name="text" id="text-input" style="resize: none"><%= text %></textarea>

        <label for="key">Key</label>

        <input name="key" id="key" type="text" value="<%= key %>">

        <br><br>

        <input name="action" type="submit" value="encrypt/decrypt">

    </form>

</main>

<%- include("../partials/footer.ejs") %>