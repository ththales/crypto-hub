<%- include("../partials/header.ejs"); %>

<main>
    <h2>ARABICA-2RS Encryption</h1>
    <br>
    <form action="/custom/arabica" method="POST">
    
        <label for="text-input">
            Type or paste in the text you want to encrypt or decrypt
        </label>
    
        <br>
    
        <textarea name="text" id="text-input" style="resize: none"><%= text %></textarea>
    
        <br><br>
    
        <button type="submit" name="action" value="encrypt">
            Encrypt
        </button>
    
        <button type="submit" name="action" value="decrypt">
            Decrypt
        </button>
    
    </form>
</main>

<%- include("../partials/footer.ejs") %>