
    <body>
        <%- include("../partials/header.ejs"); %>

        <main>
            <h2>3DES Encryption</h1>
            <br>
            <form action="/3des" method="POST">
                <label for="text-input">Type or paste in the text you want to encrypt or decrypt</label>
                <br>
                <textarea name="text" style="resize: none"><%= text %></textarea>

                <labeL for="key">Key</labeL>
                <input name="key" type="text" value="<%= key %>">
                <br><br>

                <input name="action" type="submit" value="encrypt">
                <input name="action" type="submit" value="decrypt">
            </form>
        </main>

        <%- include("../partials/footer.ejs") %>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    </body>
</html>